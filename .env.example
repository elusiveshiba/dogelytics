# Dogelytics Configuration
# Copy this file to .env and customize for your environment

# =============================================================================
# PostgreSQL Configuration
# =============================================================================

# Indexer API URL
# Dogelytics reads balances and sync heights from the indexer HTTP API
INDEXER_API_URL=http://localhost:8000

# Dogelytics Database URL (users, API keys, sessions - read/write)
# Run ./scripts/setup-auth-db.sh to create this database automatically
DOGELYTICS_DBURL=postgres://dogelytics:changeme@localhost:5432/dogelytics?sslmode=disable

# =============================================================================
# Server Configuration
# =============================================================================

# HTTP Server Bind Address
# Use "0.0.0.0:4420" to listen on all interfaces, or "localhost:4420" for local only
BIND=localhost:4420

# CORS Origin
# Set to specific domain like "https://example.com" or "*" for all origins
CORS=*

# Number of Confirmations for Available Balance
# How many confirmations required before considering funds as available
CONFIRMATIONS=6

# =============================================================================
# Rate Limiting
# =============================================================================

# Per-IP Rate Limit (requests per minute)
# Rate limit for requests without API keys
# Set to 0 to disable
RATELIMIT=10

# Per-API-Key Rate Limit (requests per minute)
# Rate limit for authenticated requests with valid API keys
# Set to 0 to disable
API_KEY_RATELIMIT=120

# =============================================================================
# Authentication & Web UI
# =============================================================================

# Session Secret (required for the admin UI)
# Generate a secure random string for production
# Example: openssl rand -base64 32
SESSION_SECRET=

# Maximum API Keys Per User
# How many active API keys each user can have
MAX_KEYS_PER_USER=1

# Enable Admin UI
# Set to true to enable the login, registration, and API key management UI
ENABLE_ADMIN_UI=false

# Admin UI Port
# The admin UI listens on the same host as BIND, using this port
ADMIN_UI_PORT=4421

# Enable Dashboard UI
# Set to true to enable the public dashboard wallet checker UI
ENABLE_DASHBOARD_UI=false

# Dashboard UI Port
# The dashboard UI listens on the same host as BIND, using this port
DASHBOARD_UI_PORT=4422

# Enable Dashboard Tips
# Set to false to hide the "Such coffee?" tips widget on the dashboard
ENABLE_DASHBOARD_TIPS=true

# Dashboard Tips Address
# Dogecoin address shown in the dashboard tips widget
DASHBOARD_TIPS_ADDRESS=DChPB3HbQgNYgWRrpeRKqNT6939rRLceNz

# Enable User Signups
# Set to false to disable user registration through the admin UI
# When disabled, new users can only be created via the admin CLI tool
# Requires ENABLE_ADMIN_UI=true to have any effect
ENABLE_SIGNUPS=false
# Dogelytics Configuration
# Copy this file to .env and customize for your environment

# =============================================================================
# PostgreSQL Configuration
# =============================================================================

# Indexer Database URL (blockchain data - read only)
# Format: postgres://username:password@host:port/database?sslmode=disable
INDEXER_DBURL=postgres://indexer:changeme@localhost:5432/indexer?sslmode=disable

# Dogelytics Database URL (users, API keys, sessions - read/write)
# This is separate from the indexer database for security and isolation
# Run ./scripts/setup-auth-db.sh to create this database automatically
DOGELYTICS_INDEXER_DBURL=postgres://dogelytics:changeme@localhost:5432/dogelytics?sslmode=disable

# =============================================================================
# Server Configuration
# =============================================================================

# HTTP Server Bind Address
# Use "0.0.0.0:4420" to listen on all interfaces, or "localhost:4420" for local only
BIND=localhost:4420

# CORS Origin
# Set to specific domain like "https://example.com" or "*" for all origins
CORS=*

# Number of Confirmations for Available Balance
# How many confirmations required before considering funds as available
CONFIRMATIONS=6

# =============================================================================
# Rate Limiting
# =============================================================================

# Per-IP Rate Limit (requests per minute)
# Rate limit for requests without API keys
# Set to 0 to disable
RATELIMIT=10

# Per-API-Key Rate Limit (requests per minute)
# Rate limit for authenticated requests with valid API keys
# Set to 0 to disable
API_KEY_RATELIMIT=120

# =============================================================================
# Authentication & Web UI
# =============================================================================

# Session Secret (REQUIRED for UI and authentication)
# Generate a secure random string for production
# Example: openssl rand -base64 32
SESSION_SECRET=

# Maximum API Keys Per User
# How many active API keys each user can have
MAX_KEYS_PER_USER=1

# Enable Web UI
# Set to false to disable all web UI endpoints (login, register, keys pages)
# When disabled, only the API endpoints (/balance, /health) will be available
ENABLE_UI=true

# Enable User Signups
# Set to false to disable user registration through the UI
# When disabled, new users can only be created via the admin CLI tool
# Requires ENABLE_UI=true to have any effect
ENABLE_SIGNUPS=true

# =============================================================================
# Notes
# =============================================================================
#
# 1. Run ./scripts/setup-auth-db.sh to create the dogelytics database automatically
#
# 2. For production deployments:
#    - Change all passwords from 'changeme' to secure values
#    - Generate a strong SESSION_SECRET: openssl rand -base64 32
#    - If you don't want to allow others to sign up for your service, set ENABLE_SIGNUPS=false to prevent external registrations
#    - Consider setting CORS to specific domains instead of "*"
#
# 3. To create users when ENABLE_SIGNUPS=false:
#    go run ./cmd/admin create-user --email user@example.com --password securepass123
#

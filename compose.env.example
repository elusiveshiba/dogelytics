# Docker Compose publishes only to localhost unless this is changed.
DOGELYTICS_HOST=127.0.0.1

# The indexer is managed separately. This default reaches port 8000 on the host.
# Remote example: http://192.0.2.20:8000
# External-network example: http://dogecoin-indexer:8000
INDEXER_API_URL=http://host.docker.internal:8000

ENABLE_ADMIN_UI=true
ENABLE_DASHBOARD_UI=true
ENABLE_SIGNUPS=false
ENABLE_ANALYTICS=true
ANALYTICS_RETENTION_DAYS=30
CORS=*

# Set these when Dogelytics is behind a reverse proxy.
PUBLIC_URL=
TRUSTED_PROXIES=
